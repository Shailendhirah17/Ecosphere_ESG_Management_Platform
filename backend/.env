EMAIL_PASSWORD=testpassword
EMAIL_FROM=noreply@ecosphere.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# App Configuration
APP_NAME=EcoSphere
APP_VERSION=1.0.0
