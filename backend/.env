# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=ecosphere_db
DB_PORT=3306
DB_DIALECT=mysql

# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=ecosphere_jwt_secret_key_development
